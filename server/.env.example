# ---------------------------------------------------------------------------
# Copy this file to `.env` and it will run as-is against `docker compose up -d`.
#
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows cmd)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# The only values you MUST change before deploying anywhere real are the two
# JWT secrets. Generate them with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Matches the credentials in docker-compose.yml. If you installed PostgreSQL
# yourself instead, change the user, password and database to match.
DATABASE_URL="postgresql://techtrackers:techtrackers@localhost:5432/techtrackers?schema=public"

# CHANGE BOTH OF THESE BEFORE DEPLOYING. They are deliberately obvious
# placeholders so a real secret is never mistaken for one of them. Must be at
# least 32 characters, and the two must differ.
JWT_ACCESS_SECRET=local-development-only-not-a-real-secret-access-000
JWT_REFRESH_SECRET=local-development-only-not-a-real-secret-refresh-00
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Where the React app runs. Add any other origin that needs to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# The background job that escalates tickets past their SLA deadline.
# Run it on exactly ONE instance if you ever scale to more than one.
SLA_JOB_ENABLED=true
SLA_JOB_INTERVAL_MS=60000

# Leave SMTP_HOST EMPTY for local testing. Emails — including password-reset
# codes — are then printed to this server's console instead of being sent,
# which is what makes the reset flow testable without a mail account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Techtrackers <no-reply@techtrackers.local>"
