NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

DATABASE_URL="postgresql://postgres:lunga@123@localhost:5432/techtrackers?schema=public"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

SLA_JOB_ENABLED=true
SLA_JOB_INTERVAL_MS=60000

# Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Techtrackers <no-reply@techtrackers.local>"

# Web push (browser notifications). Leave both empty to log to the console
# instead of sending. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@techtrackers.local
